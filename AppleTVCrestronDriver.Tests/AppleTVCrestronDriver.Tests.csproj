<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<RootNamespace>AppleTV.CrestronDriver.Tests</RootNamespace>

		<!--
			AppleTVCrestronDriver.csproj IL-merges AppleTVControlLibrary/AppleTVControlLibrary.Discovery
			into its own output assembly after Build (see its MergeDependencies target), so this project's
			ProjectReference below already sees types like HapCredentials as part of the driver assembly.
			Without this, MSBuild also transitively flows the driver project's own PackageReference to the
			AppleTVControlLibrary NuGet package into this project, so both the driver assembly and the
			original library assembly define HapCredentials, and using it here becomes ambiguous (CS0433).
		-->
		<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
	</PropertyGroup>
	<PropertyGroup>
		<VSTestUseHost>true</VSTestUseHost>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
		<PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
		<!-- AppleTVCrestronDriver.csproj IL-merges AppleTVControlLibrary.Discovery into its own output
			 assembly (see MergeDependencies below), so this project already sees types like
			 CompanionDiscoveryResult as part of the driver assembly. Unlike some packages, both
			 AppleTVControlLibrary and AppleTVControlLibrary.Discovery ship actual lib/net472 assemblies,
			 and MSBuild otherwise still flows those PackageReferences transitively from the driver
			 project even with DisableTransitiveProjectReferences above (which only suppresses transitive
			 ProjectReferences, not PackageReferences). Without excluding their compile assets here, both
			 the driver assembly and the original library assemblies define the same types (e.g.
			 CompanionDiscoveryResult, HapCredentials since AppleTVControlLibrary's package bundles
			 AppleTv.Hap.dll too), and using them here becomes ambiguous (CS0433). -->
		<PackageReference Include="AppleTVControlLibrary" Version="2.2.5" ExcludeAssets="compile" />
		<PackageReference Include="AppleTVControlLibrary.Discovery" Version="2.2.5" ExcludeAssets="compile" />
	</ItemGroup>

	<ItemGroup>
		<!-- This project is the public/publishable test suite: it builds AppleTVCrestronDriver
			 against the real Crestron.DeviceDrivers.DevKit/Crestron.SimplSharp.SDK.Library
			 packages (the default configuration - no Properties override needed). Anything that
			 needs an alternate SDK test double lives in a separate, non-public sibling project
			 instead, which is intentionally never referenced from this pushed project file.

			 DeployAfterBuild=false is forced on both driver ProjectReferences below: both
			 AppleTVCrestronDriver.csproj and AppleTVCrestronExtensionDriver.csproj have a
			 DeployDriver target that runs after every Debug build when DeployAfterBuild=true and
			 CrestronHomeIP is set - which .Local.targets/.csproj.user default to on a dev machine
			 set up for F5 deploys. Without this override, simply building this test project would
			 package and deploy both drivers to the real Crestron Home processor. -->
		<ProjectReference Include="..\AppleTVCrestronDriver\AppleTVCrestronDriver.csproj" Properties="DeployAfterBuild=false" />
		<ProjectReference Include="..\AppleTVCrestronExtensionDriver\AppleTVCrestronExtensionDriver.csproj" Properties="DeployAfterBuild=false" />

		<!--
			AppleTVControlLibrary's own test suite ships a reusable in-memory fake Companion
			Apple TV (FakeCompanionDevice/FakeCompanionOpackDevice/FakeCompanionTcpHost) that
			can drive pairing/API integration tests without a socket or real device. Referencing
			it here lets this project reuse those fakes instead of reimplementing them.
			DisableTransitiveProjectReferences above keeps this project from also picking up
			FakeDevice's own ProjectReference to AppleTV.Companion (source), which would
			otherwise define HapCredentials a second time alongside the driver's IL-merged copy.
		-->
		<ProjectReference Include="..\..\AppleTVControlLibrary\tests\AppleTV.Companion.FakeDevice\AppleTV.Companion.FakeDevice.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- AppleTVCrestronDriver.csproj's own Reference to Newtonsoft.Json.Compact (see its
			 alternate-SDK-build ItemGroup) does not flow through as a copy-local item into this
			 project's own output directory via the ProjectReference above, unlike the RAD
			 assemblies pulled in transitively via PackageReference. Referencing it directly
			 here ensures it actually lands next to AppleTVCrestronDriver.Tests.dll, since
			 real Crestron Home processors have it onboard already but the test runner does not. -->
		<Reference Include="Newtonsoft.Json.Compact">
			<HintPath>..\Newtonsoft.Json.Compact.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>

</Project>
