    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" PrivateAssets="all" />
    <Reference Include="Newtonsoft.Json.Compact"><HintPath>../Newtonsoft.Json.Compact.dll</HintPath><Private>true</Private></Reference>
