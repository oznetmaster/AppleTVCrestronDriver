<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	 <TargetFramework>net472</TargetFramework>
	 <OutputType>Library</OutputType>
	 <AssemblyName>AppleTVManifestTest</AssemblyName>
	 <RootNamespace>AppleTV.ManifestTest</RootNamespace>
	 <LangVersion>latest</LangVersion>
	 <AssemblyTitle>AppleTVManifestTest</AssemblyTitle>
	 <AssemblyDescription></AssemblyDescription>
	 <AssemblyConfiguration></AssemblyConfiguration>
	 <AssemblyCompany></AssemblyCompany>
	 <AssemblyProduct>AppleTVManifestTest</AssemblyProduct>
	 <AssemblyCopyright>Copyright © 2026</AssemblyCopyright>
	 <AssemblyTrademark></AssemblyTrademark>
	 <AssemblyCulture></AssemblyCulture>
	 <AssemblyVersion>1.0.0.0</AssemblyVersion>
	 <FileVersion>1.0.0.0</FileVersion>
	 <ComVisible>false</ComVisible>
	 <Nullable>disable</Nullable>
	 <ManifestUtilExe Condition="'$(ManifestUtilExe)' == ''">C:\Applications (x86)\Crestron\Driver SDK\ManifestUtil\ManifestUtil.exe</ManifestUtilExe>
  </PropertyGroup>

	  <ItemGroup>
	 <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
		 <_Parameter1>8a4b8e62-c709-4fa3-b61f-cc2b0b9f1e9d</_Parameter1>
	 </AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
	 <PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="27.0.24" />
	 <PackageReference Include="Crestron.SimplSharp.SDK.Library" Version="2.21.274" />
		<PackageReference Include="AppleTVControlLibrary" Version="1.1.2" />
	 <PackageReference Include="AppleTVControlLibrary.Discovery" Version="1.1.2" />
	 <PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
  </ItemGroup>

	 <ItemGroup>
		<Compile Remove="ManifestTestVideoServer.cs" />
		<Compile Include="..\AppleTVCrestronDriver\AppleTvCompanionPairing.cs" Link="AppleTvCompanionPairing.cs" />
		<Compile Include="..\AppleTVCrestronDriver\AppleTvCompanionSession.cs" Link="AppleTvCompanionSession.cs" />
		<Compile Include="..\AppleTVCrestronDriver\AppleTvNoOpTransport.cs" Link="AppleTvNoOpTransport.cs" />
		<Compile Include="..\AppleTVCrestronDriver\AppleTvStoredDevice.cs" Link="AppleTvStoredDevice.cs" />
		<Compile Include="..\AppleTVCrestronDriver\AppleTvVideoServer.cs" Link="AppleTvVideoServer.cs" />
		<Compile Include="..\AppleTVCrestronDriver\AppleTvVideoServerProtocol.cs" Link="AppleTvVideoServerProtocol.cs" />
		<Compile Include="..\AppleTVCrestronDriver\SharedStorage.cs" Link="SharedStorage.cs" />
  </ItemGroup>

  <ItemGroup>
	 <EmbeddedResource Include="AppleTVManifestTest.json" />
  </ItemGroup>

	<Target Name="MergeTestDependencies" AfterTargets="Build" BeforeTargets="PackageDriver" Condition="'$(RunMergeTest)' == 'true'">
	 <ItemGroup>
		<MergeTestInputs Include="$(TargetPath)" />
		<MergeTestInputs Include="$(TargetDir)AppleTVControlLibrary.dll" />
		<MergeTestInputs Include="$(TargetDir)AppleTVControlLibrary.Discovery.dll" />
		<MergeTestInputs Include="$(TargetDir)BouncyCastle.Cryptography.dll" />
		<MergeTestInputs Include="$(TargetDir)Microsoft.Bcl.AsyncInterfaces.dll" />
		<MergeTestInputs Include="$(TargetDir)plist-cil.dll" />
		<MergeTestInputs Include="$(TargetDir)System.Buffers.dll" />
		<MergeTestInputs Include="$(TargetDir)System.Memory.dll" />
		<MergeTestInputs Include="$(TargetDir)System.Numerics.Vectors.dll" />
		<MergeTestInputs Include="$(TargetDir)System.Runtime.CompilerServices.Unsafe.dll" />
		<MergeTestInputs Include="$(TargetDir)System.Threading.Tasks.Extensions.dll" />
		<MergeTestInputs Include="$(TargetDir)Hafner.Compatibility.CallerInformationAttributes.G2.dll" />
		<MergeTestInputs Include="$(TargetDir)Hafner.Compatibility.ConstantExpectedAttribute.dll" />
		<MergeTestInputs Include="$(TargetDir)Hafner.Compatibility.DynamicallyAccessedMembersAttribute.dll" />
		<MergeTestInputs Include="$(TargetDir)Hafner.Compatibility.ExperimentalAttribute.dll" />
		<MergeTestInputs Include="$(TargetDir)Hafner.Compatibility.FeatureGuardAttribute.dll" />
		<MergeTestInputs Include="$(TargetDir)Hafner.Compatibility.MetaPackage.dll" />
		<MergeTestInputs Include="$(TargetDir)Hafner.Compatibility.NullableReferenceTypeAttributes.G1.dll" />
		<MergeTestInputs Include="$(TargetDir)Hafner.Compatibility.NullableReferenceTypeAttributes.G2.dll" />
		<MergeTestInputs Include="$(TargetDir)Hafner.Compatibility.NullableReferenceTypeAttributes.G3.dll" />
	 </ItemGroup>
	  <PropertyGroup>
		<MergeTestStage>$(TargetDir)merge-stage</MergeTestStage>
	 </PropertyGroup>
	 <RemoveDir Directories="$(MergeTestStage)" />
	 <MakeDir Directories="$(MergeTestStage)" />
		 <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MergeTestStage)\$(AssemblyName).input.dll" />
	 <Copy SourceFiles="@(MergeTestInputs)" DestinationFiles="@(MergeTestInputs->'$(MergeTestStage)\%(Filename)%(Extension)')" Condition="'%(MergeTestInputs.Filename)' != '$(AssemblyName)'" />
	 <ItemGroup>
		<StagedMergeTestInputs Include="$(MergeTestStage)\$(AssemblyName).input.dll" />
		<StagedMergeTestInputs Include="$(MergeTestStage)\%(MergeTestInputs.Filename)%(MergeTestInputs.Extension)" Condition="'%(MergeTestInputs.Filename)' != '$(AssemblyName)'" />
	 </ItemGroup>
	 <WriteLinesToFile File="$(MergeTestStage)\merge-test-inputs.txt" Lines="@(StagedMergeTestInputs)" Overwrite="true" />
	 <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\ILRepackMerge.ps1&quot; -TargetPath &quot;$(MergeTestStage)\$(AssemblyName).dll&quot; -InputListFile &quot;$(MergeTestStage)\merge-test-inputs.txt&quot; -LibDir &quot;$(MergeTestStage)&quot; -SdkLibDir &quot;C:\Temp\SDK27\Libraries&quot; -FxRefDir &quot;C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7.2&quot; -FxRuntimeDir &quot;C:\Windows\Microsoft.NET\Framework64\v4.0.30319&quot;" />
	 <Copy SourceFiles="$(MergeTestStage)\$(AssemblyName).dll" DestinationFiles="$(TargetPath)" />
  </Target>

	 <Target Name="PatchTestAssembly" AfterTargets="MergeTestDependencies" BeforeTargets="PackageDriver" Condition="'$(RunPatchTest)' == 'true'">
	 <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\PatchMergedAssembly.ps1&quot; -AssemblyPath &quot;$(TargetPath)&quot; -OutputPath &quot;$(TargetDir)$(AssemblyName).patched.dll&quot;" />
	 <Copy SourceFiles="$(TargetDir)$(AssemblyName).patched.dll" DestinationFiles="$(TargetPath)" />
  </Target>

  <Target Name="PackageDriver" AfterTargets="PatchTestAssembly">
	 <Exec Command="&quot;$(ManifestUtilExe)&quot; --file &quot;$(TargetPath)&quot; --lib &quot;$(TargetDir.TrimEnd('\'))&quot; --output &quot;$(TargetDir.TrimEnd('\'))&quot;" />
  </Target>
</Project>
