<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<OutputType>Library</OutputType>
		<AssemblyName>AppleTVCrestronExtensionDriver</AssemblyName>
		<RootNamespace>AppleTV.CrestronDriver.Extension</RootNamespace>
		<LangVersion>latest</LangVersion>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);ILLink1005;CS1591</NoWarn>
		<Nullable>disable</Nullable>
		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<PackageType>CrestronHomeDriver</PackageType>
		<PackageId>CrestronHomeDriver.Apple.AppleTVExtension</PackageId>
		<Authors>Neil Colvin</Authors>
		<Company>Neil Colvin</Company>
		<Description>Crestron Home Entity V2 Extension Driver for Apple TV app selection and remote control.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<RepositoryUrl>https://github.com/oznetmaster/AppleTVCrestronDriver</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageProjectUrl>https://github.com/oznetmaster/AppleTVCrestronDriver</PackageProjectUrl>
		<PackageTags>crestron;crestron-home;driver;pkg;apple;appletv;extension;smarthome</PackageTags>
		<PackageDriverPkgPath Condition="'$(PackageDriverPkgPath)' == ''"></PackageDriverPkgPath>
		<PackageDriverManifestPath Condition="'$(PackageDriverManifestPath)' == ''"></PackageDriverManifestPath>
		<TreatWarningsAsErrors Condition="'$(Configuration)' == 'Debug'">true</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- Lets the release workflow supply the GitHub Release notes as the NuGet package's release notes without
		  needing to escape multi-line text on the dotnet pack command line: it writes the notes to a plain text
		  file and passes that file's path in via PackageReleaseNotesFile, which is read here at pack time. -->
	<PropertyGroup Condition="'$(PackageReleaseNotesFile)' != '' And Exists('$(PackageReleaseNotesFile)')">
		<PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(PackageReleaseNotesFile)'))</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
			<_Parameter1>9C1B9F55-4C2E-4B3A-9F7E-3E5C2F6C9E10</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AppleTVControlLibrary" Version="1.1.4" />
		<PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="27.0.24" />
		<PackageReference Include="Crestron.SimplSharp.SDK.Library" Version="2.21.274" />
		<PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
		<PackageReference Include="IsExternalInit" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- Linked (not referenced via ProjectReference) so this driver can reuse the shared credential-file
		  lookup logic (AppleTvStoredDevice/ICredentialFileStore/CrestronCredentialFileStore/SharedStorage) -
		  used only to resolve the Apple TV Companion Link video server driver's stored UniqueId for a given
		  Apple TV name, never to read or reuse its pairing credentials - plus the bridge client/port/protocol
		  helpers (AppleTvBridgeClient/AppleTvBridgePort/AppleTvBridgeProtocol) that let this driver talk to
		  that video server driver's loopback bridge server. A ProjectReference was deliberately avoided:
		  AppleTVCrestronDriver.csproj's build output is ILRepack-merged with AppleTvControlLibrary as a
		  post-build step, so referencing that project directly would pull in a second, separately-merged copy
		  of AppleTvControlLibrary's public types (e.g. HidCommand, MediaControlCommand) alongside this
		  project's own direct PackageReference to AppleTvControlLibrary, causing CS0433 duplicate-type errors.
		  Linking the source files instead compiles them once, directly against this project's own
		  AppleTvControlLibrary reference. This driver no longer owns any live Companion Link session/pairing
		  of its own - AppleTvCompanionSession/AppleTvCompanionPairing are intentionally not linked here. --> 
	<ItemGroup>
		<Compile Include="..\AppleTVCrestronDriver\SharedStorage.cs" Link="Shared\SharedStorage.cs" />
		<Compile Include="..\AppleTVCrestronDriver\ICredentialFileStore.cs" Link="Shared\ICredentialFileStore.cs" />
		<Compile Include="..\AppleTVCrestronDriver\CrestronCredentialFileStore.cs" Link="Shared\CrestronCredentialFileStore.cs" />
		<Compile Include="..\AppleTVCrestronDriver\AppleTvStoredDevice.cs" Link="Shared\AppleTvStoredDevice.cs" />
		<Compile Include="..\AppleTVCrestronDriver\AppleTvBridgeProtocol.cs" Link="Shared\AppleTvBridgeProtocol.cs" />
		<Compile Include="..\AppleTVCrestronDriver\AppleTvBridgePort.cs" Link="Shared\AppleTvBridgePort.cs" />
		<Compile Include="..\AppleTVCrestronDriver\AppleTvBridgeClient.cs" Link="Shared\AppleTvBridgeClient.cs" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="AppleTVCrestronExtensionDriver.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="CHANGELOG.md" />
		<None Include="..\LICENSE" Link="LICENSE" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(PackageDriverPkgPath)" Pack="true" PackagePath="\" Visible="false" Condition="'$(PackageDriverPkgPath)' != ''" />
		<None Include="$(PackageDriverManifestPath)" Pack="true" PackagePath="\" Visible="false" Condition="'$(PackageDriverManifestPath)' != ''" />
		<None Include="IncludeInPkg\UiDefinitions\UiDefinition.xml" />
		<None Include="IncludeInPkg\Translations\en-US.json" />
		<None Include="BumpDriverVersion.ps1" />
		<None Include="Deploy.ps1" />
		<None Include="ILRepackMerge.ps1" />
		<None Include="PatchMergedAssembly.ps1" />
		<None Include="FixPkgPathSeparators.ps1" />
		<None Include="AppleTVCrestronExtensionDriver.csproj.user" Condition="Exists('AppleTVCrestronExtensionDriver.csproj.user')" />
		<None Include="AppleTVCrestronExtensionDriver.Local.targets" Condition="Exists('AppleTVCrestronExtensionDriver.Local.targets')" />
	</ItemGroup>

	<PropertyGroup>
		<LocalCrestronSdkLibDir Condition="'$(LocalCrestronSdkLibDir)' == ''">$(CRESTRON_DRIVER_SDK_LIBRARIES)</LocalCrestronSdkLibDir>
		<LocalNet472ReferenceAssemblies Condition="'$(LocalNet472ReferenceAssemblies)' == ''">$(NET472_REFERENCE_ASSEMBLIES)</LocalNet472ReferenceAssemblies>
		<LocalNetFxRuntimeDir Condition="'$(LocalNetFxRuntimeDir)' == ''">$(NETFX_RUNTIME_DIR)</LocalNetFxRuntimeDir>
		<ManifestUtilExe Condition="'$(ManifestUtilExe)' == ''">ManifestUtil.exe</ManifestUtilExe>
		<MergeDependenciesContinueOnError Condition="'$(MergeDependenciesContinueOnError)' == ''">true</MergeDependenciesContinueOnError>
		<PackageDriverContinueOnError Condition="'$(PackageDriverContinueOnError)' == ''">true</PackageDriverContinueOnError>
		<PackageDriverIgnoreExitCode Condition="'$(PackageDriverIgnoreExitCode)' == ''">true</PackageDriverIgnoreExitCode>
	</PropertyGroup>

	<Target Name="BumpDriverVersion" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildProjectDirectory)\BumpDriverVersion.ps1')">
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\BumpDriverVersion.ps1&quot; -ManifestPath &quot;$(MSBuildProjectDirectory)\AppleTVCrestronExtensionDriver.json&quot; -Configuration &quot;$(Configuration)&quot;" />
	</Target>

	<Target Name="MergeDependencies" AfterTargets="Build">
		<ItemGroup>
			<MergeInputs Include="$(TargetPath)" />
			<MergeInputs Include="$(TargetDir)AppleTVControlLibrary.dll" />
			<MergeInputs Include="$(TargetDir)BouncyCastle.Cryptography.dll" />
			<MergeInputs Include="$(TargetDir)Microsoft.Bcl.AsyncInterfaces.dll" />
			<MergeInputs Include="$(TargetDir)plist-cil.dll" />
			<MergeInputs Include="$(TargetDir)System.Buffers.dll" />
			<MergeInputs Include="$(TargetDir)System.Memory.dll" />
			<MergeInputs Include="$(TargetDir)System.Numerics.Vectors.dll" />
			<MergeInputs Include="$(TargetDir)System.Runtime.CompilerServices.Unsafe.dll" />
			<MergeInputs Include="$(TargetDir)System.Threading.Tasks.Extensions.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.CallerInformationAttributes.G2.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.ConstantExpectedAttribute.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.DynamicallyAccessedMembersAttribute.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.ExperimentalAttribute.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.FeatureGuardAttribute.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.MetaPackage.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.NullableReferenceTypeAttributes.G1.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.NullableReferenceTypeAttributes.G2.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.NullableReferenceTypeAttributes.G3.dll" />
		</ItemGroup>
		<WriteLinesToFile File="$(TargetDir)merge_inputs.txt" Lines="@(MergeInputs)" Overwrite="true" />
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\ILRepackMerge.ps1&quot; -TargetPath &quot;$(TargetPath)&quot; -InputListFile &quot;$(TargetDir)merge_inputs.txt&quot; -LibDir &quot;$(TargetDir.TrimEnd('\'))&quot; -SdkLibDir &quot;$(LocalCrestronSdkLibDir)&quot; -FxRefDir &quot;$(LocalNet472ReferenceAssemblies)&quot; -FxRuntimeDir &quot;$(LocalNetFxRuntimeDir)&quot;" ContinueOnError="$(MergeDependenciesContinueOnError)" />
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\PatchMergedAssembly.ps1&quot; -AssemblyPath &quot;$(TargetPath)&quot; -OutputPath &quot;$(TargetDir)patched\$(AssemblyName).dll&quot;" ContinueOnError="false" />
	</Target>

	<Target Name="PackageDriver" AfterTargets="MergeDependencies">
		<RemoveDir Directories="$(TargetDir)patched\IncludeInPkg" />
		<ItemGroup>
			<IncludeInPkgFiles Include="$(MSBuildProjectDirectory)\IncludeInPkg\**\*" Exclude="$(MSBuildProjectDirectory)\IncludeInPkg\**\*.xsd" />
		</ItemGroup>
		<Copy SourceFiles="@(IncludeInPkgFiles)" DestinationFiles="@(IncludeInPkgFiles->'$(TargetDir)patched\IncludeInPkg\%(RecursiveDir)%(Filename)%(Extension)')" />
		<Exec Command="&quot;$(ManifestUtilExe)&quot; --file &quot;$(TargetDir)patched\$(AssemblyName).dll&quot; --lib &quot;$(TargetDir.TrimEnd('\'))&quot; --output &quot;$(TargetDir.TrimEnd('\'))&quot;" ContinueOnError="$(PackageDriverContinueOnError)" IgnoreExitCode="$(PackageDriverIgnoreExitCode)" />
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\FixPkgPathSeparators.ps1&quot; -PkgPath &quot;$(TargetDir)$(AssemblyName).pkg&quot;" ContinueOnError="$(PackageDriverContinueOnError)" />
	</Target>

	<Target Name="DeployDriver" AfterTargets="PackageDriver" Condition="'$(DeployAfterBuild)' == 'true' And '$(Configuration)' == 'Debug' And '$(CrestronHomeIP)' != ''">
		<PropertyGroup>
			<PkgFile>$(TargetDir)$(AssemblyName).pkg</PkgFile>
			<DeployScriptPath>$(MSBuildProjectDirectory)\Deploy.ps1</DeployScriptPath>
		</PropertyGroup>
		<Message Text="Deploying $(AssemblyName).pkg to $(CrestronHomeIP)..." Importance="High" />
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(DeployScriptPath)&quot; -PkgFile &quot;$(PkgFile)&quot; -ProcessorIP &quot;$(CrestronHomeIP)&quot; -User &quot;$(CrestronHomeFtpUser)&quot; -Password &quot;$(CrestronHomeSftpPassword)&quot;" ContinueOnError="false" />
	</Target>

	<Target Name="ValidateNuGetPkgInput" BeforeTargets="GenerateNuspec" Condition="'$(IsPacking)' == 'true'">
		<Error Condition="'$(PackageDriverPkgPath)' == ''" Text="PackageDriverPkgPath must be set when packing the NuGet package." />
		<Error Condition="!Exists('$(PackageDriverPkgPath)')" Text="PackageDriverPkgPath '$(PackageDriverPkgPath)' does not exist." />
		<Error Condition="'$(PackageDriverManifestPath)' == ''" Text="PackageDriverManifestPath must be set when packing the NuGet package." />
		<Error Condition="!Exists('$(PackageDriverManifestPath)')" Text="PackageDriverManifestPath '$(PackageDriverManifestPath)' does not exist." />
	</Target>

	<Import Project="AppleTVCrestronExtensionDriver.Local.targets" Condition="Exists('AppleTVCrestronExtensionDriver.Local.targets')" />

</Project>
