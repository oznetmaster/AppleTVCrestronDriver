<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<OutputType>Library</OutputType>
		<AssemblyName>AppleTVCrestronCloudDriver</AssemblyName>
		<RootNamespace>AppleTV.CrestronDriver</RootNamespace>
		<LangVersion>latest</LangVersion>
		<AssemblyTitle>AppleTVCrestronDriver</AssemblyTitle>
		<AssemblyDescription></AssemblyDescription>
		<AssemblyConfiguration></AssemblyConfiguration>
		<AssemblyCompany></AssemblyCompany>
		<AssemblyProduct>AppleTVCrestronDriver</AssemblyProduct>
		<AssemblyCopyright>Copyright © 2026</AssemblyCopyright>
		<AssemblyTrademark></AssemblyTrademark>
		<AssemblyCulture></AssemblyCulture>
		<AssemblyVersion>1.4.1.0</AssemblyVersion>
		<FileVersion>1.4.1.0</FileVersion>
		<ComVisible>false</ComVisible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);ILLink1005</NoWarn>
		<Nullable>disable</Nullable>
		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<PackageType>CrestronHomeDriver</PackageType>
		<PackageId>CrestronHomeDriver.Apple.AppleTV</PackageId>
		<Authors>Neil Colvin</Authors>
		<Company>Neil Colvin</Company>
		<Description>Crestron Home RAD Driver for AppleTV.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<RepositoryUrl>https://github.com/oznetmaster/AppleTVCrestronDriver</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageProjectUrl>https://github.com/oznetmaster/AppleTVCrestronDriver</PackageProjectUrl>
		<PackageTags>crestron;crestron-home;driver;pkg;apple;appletv;smarthome</PackageTags>
		<PackageDriverPkgPath Condition="'$(PackageDriverPkgPath)' == ''"></PackageDriverPkgPath>
		<PackageDriverManifestPath Condition="'$(PackageDriverManifestPath)' == ''"></PackageDriverManifestPath>
		<TreatWarningsAsErrors Condition="'$(Configuration)' == 'Debug'">true</TreatWarningsAsErrors>
		<!-- The SDK's default compile-item excludes are derived from the *current* BaseIntermediateOutputPath/
			 BaseOutputPath (which differ for the alternate SDK build variant), so a normal obj\Debug\.../
			 bin\Debug\... build output left over from a plain build of this project is no longer excluded and
			 its generated AssemblyInfo/AssemblyAttributes .cs files get compiled a second time here, causing
			 CS0579 duplicate attribute errors. Always exclude both obj\ and bin\ regardless of which variant
			 is currently building. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
		<!-- Belt-and-braces: never let the alternate SDK test-build variant be packed, even if `dotnet pack`
			 is invoked directly against it. BaseOutputPath/BaseIntermediateOutputPath for that
			 variant are supplied as global properties from a private, non-published test project's
			 ProjectReference (see its Properties metadata), not here, since overriding them this
			 late would not take effect before the SDK's default item excludes are computed. -->
		<IsPackable Condition="'$(UseAlternateSdkBuild)' == 'true'">false</IsPackable>
	</PropertyGroup>

	<!-- Lets the release workflow supply the GitHub Release notes as the NuGet package's release notes without
		  needing to escape multi-line text on the dotnet pack command line: it writes the notes to a plain text
		  file and passes that file's path in via PackageReleaseNotesFile, which is read here at pack time. -->
	<PropertyGroup Condition="'$(PackageReleaseNotesFile)' != '' And Exists('$(PackageReleaseNotesFile)')">
		<PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(PackageReleaseNotesFile)'))</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
			<_Parameter1>bc188e51-ede8-4dec-9861-fc7ff4233d37</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>AppleTVCrestronDriver.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AppleTVControlLibrary" Version="2.2.5" />
		<PackageReference Include="AppleTVControlLibrary.Discovery" Version="2.2.5" />
		<PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="27.0.24" />
		<!-- When UseAlternateSdkBuild=true (set via ProjectReference Properties metadata from a private,
			 non-published test project), the real Crestron.SimplSharp.SDK.Library package is swapped for
			 an alternate, deterministic, in-memory test double of the SimplSharp APIs (wired up locally;
			 see AppleTVCrestronDriver.Local.targets), instead of the real appliance-only assembly. -->
		<PackageReference Include="Crestron.SimplSharp.SDK.Library" Version="2.21.274" Condition="'$(UseAlternateSdkBuild)' != 'true'" />
		<PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
		<PackageReference Include="IsExternalInit" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseAlternateSdkBuild)' == 'true'">
		<!-- The actual ProjectReference to the alternate SDK test-double project is intentionally not
			 declared here: it lives in AppleTVCrestronDriver.Local.targets (a local-only, non-published
			 file imported below) alongside its private test project. -->
		<!-- RADCommon.dll (from Crestron.DeviceDrivers.ProgramInterface, pulled in transitively by
			 Crestron.DeviceDrivers.DevKit) requires Newtonsoft.Json.Compact, Version=4.0.8.0,
			 PublicKeyToken=1099c178b3b54c3b at runtime, but no NuGet package in this dependency
			 graph actually ships that assembly - real Crestron Home processors have it onboard
			 already, so production deploys are unaffected. Test builds have no processor to supply
			 it, so without this reference any code path that touches RAD types (e.g. constructing
			 an ABasicVideoServer-derived class) fails with a FileNotFoundException at test time.
			 Reference the copy checked into the repo root purely so it gets copied into the test
			 build's output directory; never used by the real packaged/deployed driver. -->
		<Reference Include="Newtonsoft.Json.Compact">
			<HintPath>..\Newtonsoft.Json.Compact.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="AppleTVCrestronDriver.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Link="README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\LICENSE" Link="LICENSE" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(PackageDriverPkgPath)" Pack="true" PackagePath="\" Visible="false" Condition="'$(PackageDriverPkgPath)' != ''" />
		<None Include="$(PackageDriverManifestPath)" Pack="true" PackagePath="\" Visible="false" Condition="'$(PackageDriverManifestPath)' != ''" />
		<None Include="BumpDriverVersion.ps1" />
		<None Include="Deploy.ps1" />
		<None Include="ILRepackMerge.ps1" />
		<None Include="PatchMergedAssembly.ps1" />
		<None Include="FixPkgPathSeparators.ps1" />
		<None Include="AppleTVCrestronDriver.csproj.user" />
		<None Include="AppleTVCrestronDriver.Local.targets" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Properties\" />
	</ItemGroup>

	<PropertyGroup>
		<LocalCrestronSdkLibDir Condition="'$(LocalCrestronSdkLibDir)' == ''">$(CRESTRON_DRIVER_SDK_LIBRARIES)</LocalCrestronSdkLibDir>
		<LocalNet472ReferenceAssemblies Condition="'$(LocalNet472ReferenceAssemblies)' == ''">$(NET472_REFERENCE_ASSEMBLIES)</LocalNet472ReferenceAssemblies>
		<LocalNetFxRuntimeDir Condition="'$(LocalNetFxRuntimeDir)' == ''">$(NETFX_RUNTIME_DIR)</LocalNetFxRuntimeDir>
		<ManifestUtilExe Condition="'$(ManifestUtilExe)' == ''">ManifestUtil.exe</ManifestUtilExe>
		<MergeDependenciesContinueOnError Condition="'$(MergeDependenciesContinueOnError)' == ''">true</MergeDependenciesContinueOnError>
		<PackageDriverContinueOnError Condition="'$(PackageDriverContinueOnError)' == ''">false</PackageDriverContinueOnError>
		<PackageDriverIgnoreExitCode Condition="'$(PackageDriverIgnoreExitCode)' == ''">false</PackageDriverIgnoreExitCode>
	</PropertyGroup>

	<Target Name="BumpDriverVersion" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildProjectDirectory)\BumpDriverVersion.ps1')">
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\BumpDriverVersion.ps1&quot; -ManifestPath &quot;$(MSBuildProjectDirectory)\AppleTVCrestronDriver.json&quot; -Configuration &quot;$(Configuration)&quot;" />
	</Target>

		<!-- Never runs for the UseAlternateSdkBuild=true test-only build variant (see PropertyGroup above):
		 that build exists solely so a private, non-published test project can compile/run against
		 an alternate SDK test double instead of the real SDK, and must never be merged/packaged/deployed. -->
	<!-- Always runs, even for the alternate SDK test-build variant: AppleTVCrestronDriver.Tests relies on
		 AppleTVControlLibrary/AppleTv.Hap types (e.g. HapCredentials, CompanionApi) being IL-merged
		 into this assembly, since DisableTransitiveProjectReferences=true in the test project hides
		 the raw NuGet-sourced copies of those types. Only PackageDriver/DeployDriver (which produce
		 and ship a .pkg to a real Crestron processor) are skipped for the alternate SDK variant, not this. -->
	<Target Name="MergeDependencies" AfterTargets="Build" Inputs="$(TargetPath);@(ReferenceCopyLocalPaths)" Outputs="$(TargetDir)patched\$(AssemblyName).dll">
		<!-- Re-copy the resolved package/reference assemblies into $(TargetDir) immediately before merging.
			 This guards against a stale AppleTVControlLibrary*.dll (or other dependency) left over from a
			 previous build/package version being silently picked up by ILRepack, since incremental copy-local
			 can otherwise skip re-copying when only the referenced package version changed. -->
		<Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" />
		<ItemGroup>
			<MergeInputs Include="$(TargetPath)" />
			<MergeInputs Include="$(TargetDir)AppleTVControlLibrary.dll" />
			<MergeInputs Include="$(TargetDir)AppleTVControlLibrary.Discovery.dll" />
			<MergeInputs Include="$(TargetDir)AppleTv.Hap.dll" />
			<MergeInputs Include="$(TargetDir)BouncyCastle.Cryptography.dll" />
			<MergeInputs Include="$(TargetDir)Microsoft.Bcl.AsyncInterfaces.dll" />
			<MergeInputs Include="$(TargetDir)plist-cil.dll" />
			<!-- System.Memory (and its dependents System.Buffers / System.Numerics.Vectors /
				 System.Runtime.CompilerServices.Unsafe) must be merged here, like every other
				 dependency: the .pkg deployed to the Crestron processor only ships this single
				 merged assembly plus its manifest, so anything not merged would be missing at
				 runtime. Since AppleTv.Hap.dll (which defines Opack.Unpack(ReadOnlySpan<byte>, out int))
				 is merged into this same ILRepack output, System.Memory's ReadOnlySpan<byte>
				 type is unified into a single copy shared by all merged code - so merging it
				 alongside AppleTv.Hap.dll (rather than leaving it external) is what keeps a
				 single, consistent ReadOnlySpan<byte> identity. Leaving System.Memory external
				 while AppleTv.Hap.dll was merged (the previous state) is what caused a
				 MissingMethodException at runtime. -->
			<MergeInputs Include="$(TargetDir)System.Buffers.dll" />
			<MergeInputs Include="$(TargetDir)System.Memory.dll" />
			<MergeInputs Include="$(TargetDir)System.Numerics.Vectors.dll" />
			<MergeInputs Include="$(TargetDir)System.Runtime.CompilerServices.Unsafe.dll" />
			<MergeInputs Include="$(TargetDir)System.Threading.Tasks.Extensions.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.CallerInformationAttributes.G2.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.ConstantExpectedAttribute.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.DynamicallyAccessedMembersAttribute.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.ExperimentalAttribute.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.FeatureGuardAttribute.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.MetaPackage.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.NullableReferenceTypeAttributes.G1.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.NullableReferenceTypeAttributes.G2.dll" />
			<MergeInputs Include="$(TargetDir)Hafner.Compatibility.NullableReferenceTypeAttributes.G3.dll" />
		</ItemGroup>
		<WriteLinesToFile File="$(TargetDir)merge_inputs.txt" Lines="@(MergeInputs)" Overwrite="true" />
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\ILRepackMerge.ps1&quot; -TargetPath &quot;$(TargetPath)&quot; -InputListFile &quot;$(TargetDir)merge_inputs.txt&quot; -LibDir &quot;$(TargetDir.TrimEnd('\'))&quot; -SdkLibDir &quot;$(LocalCrestronSdkLibDir)&quot; -FxRefDir &quot;$(LocalNet472ReferenceAssemblies)&quot; -FxRuntimeDir &quot;$(LocalNetFxRuntimeDir)&quot;" ContinueOnError="$(MergeDependenciesContinueOnError)" />
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\PatchMergedAssembly.ps1&quot; -AssemblyPath &quot;$(TargetPath)&quot; -OutputPath &quot;$(TargetDir)patched\$(AssemblyName).dll&quot;" ContinueOnError="false" />
	</Target>

	<Target Name="PackageDriver" AfterTargets="MergeDependencies" Condition="'$(UseAlternateSdkBuild)' != 'true'">
		<RemoveDir Directories="$(TargetDir)patched\IncludeInPkg" />
		<ItemGroup>
			<IncludeInPkgFiles Include="$(MSBuildProjectDirectory)\IncludeInPkg\**\*" Exclude="$(MSBuildProjectDirectory)\IncludeInPkg\**\*.xsd" />
		</ItemGroup>
		<Copy SourceFiles="@(IncludeInPkgFiles)" DestinationFiles="@(IncludeInPkgFiles->'$(TargetDir)patched\IncludeInPkg\%(RecursiveDir)%(Filename)%(Extension)')" />
		<Exec Command="&quot;$(ManifestUtilExe)&quot; --file &quot;$(TargetDir)patched\$(AssemblyName).dll&quot; --lib &quot;$(TargetDir.TrimEnd('\'))&quot; --output &quot;$(TargetDir.TrimEnd('\'))&quot;" ContinueOnError="$(PackageDriverContinueOnError)" IgnoreExitCode="$(PackageDriverIgnoreExitCode)" />
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\FixPkgPathSeparators.ps1&quot; -PkgPath &quot;$(TargetDir)$(AssemblyName).pkg&quot;" ContinueOnError="$(PackageDriverContinueOnError)" />
	</Target>

	<!-- BuildingInsideVisualStudio is set to true only by Visual Studio's own build engine (F6/
		 Ctrl+Shift+B/F5/right-click Build or Rebuild), never by command-line MSBuild, `dotnet build`/
		 `dotnet test`, CI, or other external tooling. Without this, any tool-driven build of this
		 project that isn't routed through the public test project's UseAlternateSdkBuild=true/
		 DeployAfterBuild=false ProjectReference override (e.g. a plain `dotnet build` against this
		 .csproj, or an editor/agent invoking MSBuild directly) would silently SFTP a .pkg to the real
		 processor in CrestronHomeIP, purely because AppleTVCrestronDriver.csproj.user defaults
		 DeployAfterBuild to true for convenience during normal interactive Visual Studio use. -->
	<Target Name="DeployDriver" AfterTargets="PackageDriver" Condition="'$(UseAlternateSdkBuild)' != 'true' And '$(DeployAfterBuild)' == 'true' And '$(Configuration)' == 'Debug' And '$(CrestronHomeIP)' != '' And '$(BuildingInsideVisualStudio)' == 'true'">
		<PropertyGroup>
			<PkgFile>$(TargetDir)$(AssemblyName).pkg</PkgFile>
			<DeployScriptPath>$(MSBuildProjectDirectory)\Deploy.ps1</DeployScriptPath>
		</PropertyGroup>
		<Message Text="Deploying $(AssemblyName).pkg to $(CrestronHomeIP)..." Importance="High" />
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(DeployScriptPath)&quot; -PkgFile &quot;$(PkgFile)&quot; -ProcessorIP &quot;$(CrestronHomeIP)&quot; -User &quot;$(CrestronHomeFtpUser)&quot; -Password &quot;$(CrestronHomeSftpPassword)&quot;" ContinueOnError="false" />
	</Target>

	<Target Name="ValidateNuGetPkgInput" BeforeTargets="GenerateNuspec" Condition="'$(IsPacking)' == 'true'">
		<Error Condition="'$(PackageDriverPkgPath)' == ''" Text="PackageDriverPkgPath must be set when packing the NuGet package." />
		<Error Condition="!Exists('$(PackageDriverPkgPath)')" Text="PackageDriverPkgPath '$(PackageDriverPkgPath)' does not exist." />
		<Error Condition="'$(PackageDriverManifestPath)' == ''" Text="PackageDriverManifestPath must be set when packing the NuGet package." />
		<Error Condition="!Exists('$(PackageDriverManifestPath)')" Text="PackageDriverManifestPath '$(PackageDriverManifestPath)' does not exist." />
	</Target>

	<Import Project="AppleTVCrestronDriver.Local.targets" Condition="Exists('AppleTVCrestronDriver.Local.targets')" />

</Project>
